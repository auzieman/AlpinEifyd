builddir="$srcdir"

package() { mkdir -p "$pkgdir"; }

_theme() {
    depends=""
    replaces="alpine-spin-themes"
    pkgdesc="$1 Enlightenment theme"
    install -Dm644 "$srcdir/$2" "$subpkgdir/usr/share/elementary/themes/$2"
    install -d "$subpkgdir/usr/share/doc/$subpkgname/retained-notices"
    install -m644 "$srcdir"/AUTHORS* "$srcdir"/COPYING* "$srcdir"/README.icons "$subpkgdir/usr/share/doc/$subpkgname/retained-notices/"
}
