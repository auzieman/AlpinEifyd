#!/bin/sh
set -o pipefail
mkdir -p "$HOME/.local/state/eifyd"
if [ "$1" = disks ]; then
    lsblk -o NAME,SIZE,MODEL,FSTYPE,MOUNTPOINTS
elif [ "$1" = tui ]; then
    # Keep console interaction direct; passwords must never enter a session log.
    sudo /usr/libexec/eifyd-install tui
else
    sudo /usr/libexec/eifyd-install "$@" \
        2>&1 | tee "$HOME/.local/state/eifyd/install.log"
    result=$?
    printf '\nInstaller exit status: %s\n' "$result"
fi
printf '\nPress Enter to close this terminal.'
read -r unused
