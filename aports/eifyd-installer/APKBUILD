# Maintainer: AlpinE <builds@auzietek.com>
pkgname=eifyd-installer
pkgver=0.2.0
pkgrel=8
pkgdesc="E'ifyd Elementary front end to native Alpine desktop installation"
url="https://lab.auzietek.com/gitea/auzietek/AlpinE"
arch="all"
license="LicenseRef-Auzietek"
depends="alpine-conf python3 openssl sudo terminology lsblk rsync e2fsprogs sfdisk parted dosfstools grub grub-bios grub-efi gparted"
makedepends="efl-dev"
options="!check"
source="eifyd.c eifyd-install.py eifyd_storage.py package-groups.json eifyd-terminal eifyd.desktop mark-shield-swords.png"
builddir="$srcdir"

build() {
    ${CC:-cc} $CFLAGS -Wall -Wextra -o eifyd-installer eifyd.c $LDFLAGS $(pkg-config --cflags --libs elementary)
}

package() {
    install -Dm755 eifyd-installer "$pkgdir/usr/bin/eifyd-installer"
    install -Dm755 eifyd-install.py "$pkgdir/usr/libexec/eifyd-install"
    install -Dm644 eifyd_storage.py "$pkgdir/usr/libexec/eifyd_storage.py"
    install -Dm644 package-groups.json "$pkgdir/usr/libexec/package-groups.json"
    install -Dm755 eifyd-terminal "$pkgdir/usr/libexec/eifyd-terminal"
    install -Dm644 eifyd.desktop "$pkgdir/usr/share/applications/eifyd.desktop"
    install -Dm644 eifyd.desktop "$pkgdir/usr/share/applications/alpine-install.desktop"
    install -Dm755 eifyd.desktop "$pkgdir/etc/skel/Desktop/alpine-install.desktop"
    install -Dm644 mark-shield-swords.png "$pkgdir/usr/share/eifyd/mark-shield-swords.png"
}

