pkgname=alpine-spin-wallpapers
pkgver=20260919
pkgrel=0
pkgdesc="AlpinE mountain wallpapers"
url="https://github.com/simotek/Enlightenment-Themes"
arch="noarch"
license="CC0-1.0"
options="!check"
source="LICENSE alpine-midnight.svg alpine-violet.svg"
builddir="$srcdir"

package() {
    install -d "$pkgdir/usr/share/backgrounds/alpine" "$pkgdir/usr/share/licenses/$pkgname"
    install -m644 *.svg "$pkgdir/usr/share/backgrounds/alpine/"
    install -m644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/"
}

