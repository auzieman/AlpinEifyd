# Maintainer: AlpinE <builds@auzietek.com>
pkgname=evisum
pkgver=2.0.12
pkgrel=0
pkgdesc="Enlightenment system monitor"
url="https://www.enlightenment.org"
arch="all"
license="ISC"
makedepends="efl-dev meson gettext-dev linux-headers"
options="!check"
subpackages="$pkgname-lang"
source="https://download.enlightenment.org/rel/apps/$pkgname/$pkgname-$pkgver.tar.xz"

build() {
    abuild-meson . build
    meson compile -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

